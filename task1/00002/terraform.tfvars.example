# 이 파일은 00002 과제 전체 root module이 함께 사용하는 입력 예시입니다.
# 과제 루트에서 Copy-Item terraform.tfvars.example terraform.tfvars 로 복사한 뒤
# replace-* 값을 실제 계정 값으로 변경합니다. 실제 terraform.tfvars는 Git에 커밋하지 않습니다.
# 각 명령의 -var-file 경로는 root module 디렉터리를 기준으로 해석됩니다.

config = {
  # 모든 root module이 공유하는 과제 식별자, AWS profile과 태그입니다.
  common = {
    # 응시번호가 아니라 과제번호입니다. 고정값을 유지합니다.
    task_id = "00002"

    # 선수 비번호입니다. 문제지의 S3 버킷명과 Grafana 관리자 계정에 사용됩니다.
    # 과제번호 00002를 그대로 쓰지 말고 대회 당일 부여받은 실제 비번호로 바꿉니다.
    candidate_id = "replace-with-candidate-number"

    # null이면 현재 AWS SDK 기본 자격 증명 체인을 사용합니다.
    aws_profile = null

    tags = {
      Project   = "wskorea26-concert"
      TaskId    = "00002"
      ManagedBy = "Terraform"
    }
  }

  # 각 root module에 직접 입력하는 값입니다.
  modules = {
    foundation = {
      # 문제지의 ap-northeast-2 가용 영역 두 개를 유지합니다.
      availability_zones = ["ap-northeast-2c", "ap-northeast-2d"]
      cluster_version    = "1.35"
      lambda_runtime     = "python3.14"

      # 정상 적용은 true입니다. destroy 전 보호 해제가 필요할 때만 false로 바꿉니다.
      dynamodb_deletion_protection_enabled = true

      # CloudShell 채점 principal이 foundation 생성 principal과 다를 때만 추가합니다.
      # CloudShell에서 `aws sts get-caller-identity --query Arn --output text`로 확인하되,
      # root ARN이나 arn:aws:sts::... 세션 ARN은 넣지 않습니다.
      # assumed-role이면 대응하는 영구 arn:aws:iam::...:role/... ARN을 사용합니다.
      # 같은 principal로 foundation을 생성했다면 빈 목록을 유지합니다.
      additional_cluster_admin_principal_arns = []
    }

    application = {
      # 예시 비밀번호를 실환경 비밀로 사용하지 말고 실제 tfvars를 별도로 보호합니다.
      grafana_admin_password = "$korea26!!"
    }

    extensions = {
      grading_bastion = {
        instance_type = "t3.micro"
      }

      # Windows 대회 환경에서는 Docker/WSL 대신 CodeBuild가 이미지를 빌드합니다.
      # 정상값 10분을 유지합니다. 빌드가 실제로 오래 걸릴 때만 5~60분으로 조정합니다.
      image_build = {
        build_timeout_minutes = 10
      }
    }
  }

  # foundation 적용 후 terraform output 결과를 복사하는 구역입니다.
  outputs = {
    foundation = {
      # terraform -chdir=foundation output -raw eks_cluster_name
      eks_cluster_name = "replace-with-foundation-output"

      # terraform -chdir=foundation output -raw cluster_endpoint
      cluster_endpoint = "https://replace-me.eks.ap-northeast-2.amazonaws.com"

      # terraform -chdir=foundation output -raw cluster_ca
      # 인증서 데이터는 실제 tfvars 외부에 노출하거나 Git에 기록하지 않습니다.
      cluster_ca = "replace-with-foundation-output"

      # terraform -chdir=foundation output -raw dynamodb_table_name
      dynamodb_table_name = "replace-with-foundation-output"

      # foundation 적용 후 생성된 선수 비번호 포함 S3 버킷명을 복사합니다.
      # terraform -chdir=foundation output -raw s3_bucket_name
      s3_bucket_name = "replace-with-foundation-output"
    }
  }
}
