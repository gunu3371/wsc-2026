# 이 파일은 단일 공통 3과제의 foundation, application, monitoring이 함께 사용합니다.
# task3 루트에서 terraform.tfvars로 복사하고 foundation 적용 후 outputs를 갱신합니다.
# 실제 파일에는 계정별 ARN과 endpoint가 포함되므로 Git에 커밋하지 않습니다.

config = {
  common = {
    # task3에는 과제번호 하위 폴더가 없습니다. 이 값은 리소스 고유성을 위한 실제 응시자 식별값입니다.
    candidate_id = "00000"

    # 문제지의 고정 리전과 프로젝트 이름입니다.
    aws_region   = "ap-northeast-2"
    project_name = "apdev-task3"
  }

  modules = {
    foundation = {
      vpc_cidr     = "10.30.0.0/16"
      cluster_name = "apdev-eks-cluster"

      # null이면 provider/AWS에서 허용하는 기본 EKS 버전 선택을 따릅니다.
      # 대회 환경의 지원 버전을 확인한 뒤 필요할 때만 "1.xx"로 고정합니다.
      kubernetes_version = null

      # CloudShell 채점 역할이 생성 주체와 다를 때 실제 IAM principal ARN을 추가합니다.
      additional_cluster_admin_principal_arns = []

      db_username = "appuser"

      # 문제지상 인스턴스 타입은 t3.medium으로 고정됩니다. 디스크와 노드 수는
      # 트래픽 실측에 따라 이 객체에서 조정합니다.
      node_groups = {
        core = {
          instance_types = ["t3.medium"]
          capacity_type  = "ON_DEMAND"
          disk_size      = 30
          desired_size   = 2
          min_size       = 2
          max_size       = 2
        }
        stress = {
          instance_types = ["t3.medium"]
          capacity_type  = "ON_DEMAND"
          disk_size      = 30
          desired_size   = 1
          min_size       = 1
          max_size       = 1
        }
      }
    }

    application = {
      image_tag                       = "latest"
      replicas                        = 2
      aws_load_balancer_chart_version = "1.14.0"

      # 완전 일치하는 User-Agent를 대소문자 구분 없이 WAF에서 처리합니다.
      # 먼저 "COUNT"로 관찰한 뒤 정상 트래픽과 구분되면 "BLOCK"으로 전환할 수 있습니다.
      blocked_user_agents       = []
      blocked_user_agent_action = "BLOCK"
    }

    extensions = {
      # 추가 과제 바이너리가 지급되면 항목 하나당 ECR, 전용 EKS node group,
      # Deployment/Service/HPA/PDB와 ALB 경로가 생성됩니다. 비어 있으면 리소스를 만들지 않습니다.
      additional_workloads = {
        # example = {
        #   binary_object_key = "binaries/example"
        #   image_tag          = "latest"
        #   route_path         = "/v1/example"
        #   container_port     = 8080
        #   healthcheck_path   = "/healthcheck"
        #   replicas           = 2
        #   min_replicas       = 2
        #   max_replicas       = 3
        #   hpa_cpu_percent    = 70
        #   use_database       = false
        #   environment        = { ENV = "production" }
        #   node_group = {
        #     instance_types = ["t3.medium"]
        #     capacity_type  = "ON_DEMAND"
        #     disk_size      = 30
        #     desired_size   = 1
        #     min_size       = 1
        #     max_size       = 1
        #   }
        # }
      }

      image_build = {
        build_image = "aws/codebuild/amazonlinux-x86_64-standard:6.0"
        compute_type = "BUILD_GENERAL1_SMALL"
        image_tag    = "latest"
        binary_object_keys = {
          user    = "binaries/user"
          product = "binaries/product"
          stress  = "binaries/stress"
        }
        log_retention_days = 1
      }

      monitoring = {
        fluent_bit_chart_version = "0.2.0"
        log_retention_days       = 1
      }
    }
  }

  # foundation 적용 후 아래 명령의 결과를 복사합니다.
  outputs = {
    foundation = {
      # terraform -chdir=foundation output -raw cluster_name
      cluster_name = "replace-with-foundation-output"

      # terraform -chdir=foundation output -raw vpc_id
      vpc_id = "vpc-replace-with-foundation-output"

      # terraform -chdir=foundation output -json public_subnet_ids
      public_subnet_ids = ["subnet-replace-1", "subnet-replace-2"]

      # terraform -chdir=foundation output -json private_subnet_ids
      private_subnet_ids = ["subnet-replace-1", "subnet-replace-2"]

      # terraform -chdir=foundation output -raw node_role_name
      node_role_name = "replace-with-foundation-output"

      # terraform -chdir=foundation output -raw node_role_arn
      node_role_arn = "arn:aws:iam::123456789012:role/replace-with-foundation-output"

      # terraform -chdir=foundation output -raw core_node_group_name
      core_node_group_name = "replace-with-foundation-output"

      # terraform -chdir=foundation output -raw stress_node_group_name
      stress_node_group_name = "replace-with-foundation-output"

      # terraform -chdir=foundation output -raw database_secret_arn
      # ARN만 기록하며 secret 값 자체는 tfvars나 Git에 저장하지 않습니다.
      database_secret_arn = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:apdev-task3/database-example"

      # terraform -chdir=foundation output -raw image_bucket_name
      image_bucket_name = "apdev-task3-images-00000-123456789012"

      # terraform -chdir=foundation output -raw product_pod_role_arn
      product_pod_role_arn = "arn:aws:iam::123456789012:role/apdev-task3-product"

      # terraform -chdir=foundation output -json ecr_repository_urls
      ecr_repository_urls = {
        user    = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/apdev-task3-user"
        product = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/apdev-task3-product"
        stress  = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/apdev-task3-stress"
      }
    }

    # additional-infrastructure 적용 후 image-build, additional-application,
    # monitoring extension에 전달합니다. additional_workloads가 비어 있으면 빈 map을 유지합니다.
    additional_infrastructure = {
      # terraform -chdir=extensions/additional-infrastructure output -json ecr_repository_urls
      ecr_repository_urls = {}

      # terraform -chdir=extensions/additional-infrastructure output -json node_group_names
      node_group_names = {}
    }

    # application 적용 후 monitoring extension에 전달합니다.
    application = {
      # terraform -chdir=application output -raw alb_arn_suffix
      alb_arn_suffix = "app/replace-with-application-output/0000000000000000"

      # terraform -chdir=application output -raw cloudfront_distribution_id
      cloudfront_distribution_id = "replace-with-application-output"

      # terraform -chdir=application output -raw waf_web_acl_name
      waf_web_acl_name = "replace-with-application-output"
    }
  }
}
