# 이 파일은 00007 과제의 네 독립 root module이 함께 사용합니다.
# 과제 루트에서 terraform.tfvars로 복사하고 실제 이미지 URI만 교체합니다.
# 실제 terraform.tfvars는 Git에 커밋하지 않습니다.

config = {
  common = {
    # 응시번호가 아니라 과제번호입니다.
    task_id = "00007"
  }

  modules = {
    # 현재 직접 입력이 없는 모듈은 확장 가능한 계약을 위해 빈 구역을 유지합니다.
    cdn   = {}
    nosql = {}

    o11y = {
      # 이미지 push 후 실제 digest URI를 사용합니다.
      log_generator_image = "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/log-generator@sha256:replace-me"
      kubernetes_version  = "1.35"
    }

    scaling = {
      # 이미지 push 후 실제 digest URI를 사용합니다.
      order_processor_image = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/order-processor@sha256:replace-me"
      kubernetes_version    = "1.35"
    }
  }

  # 네 서비스는 독립적이므로 전달할 선행 module output이 없습니다.
  outputs = {}
}
